{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SiphonPull",
  "version": "0.1.0",
  "identifier": "dev.siphonpull.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SiphonPull",
        "width": 760,
        "height": 620,
        "minWidth": 560,
        "minHeight": 460,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "category": "Utility",
    "publisher": "SiphonPull",
    "copyright": "Copyright (c) 2026 SiphonPull contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "shortDescription": "Minimal video downloader",
    "longDescription": "SiphonPull is a minimal, native desktop video downloader built on Tauri, Rust and yt-dlp.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
